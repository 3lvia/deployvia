{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "minimumReleaseAge": "3 days",
  "prCreation": "not-pending",
  "packageRules": [
    {
      "matchPackageNames": [
        "^k8s.io/"
      ],
      "groupName": "Kubernetes packages"
    }
  ]
}
